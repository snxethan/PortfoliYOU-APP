{
  "name": "portfoli-you-app",
  "version": "0.1.0",
  "description": "Portfoli-YOU desktop app built with Electron, Vite, and React.",
  "author": "",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^2.1.4",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.14",
    "autoprefixer": "^10.4.21",
    "dompurify": "^3.1.6",
    "electron-updater": "^6.6.2",
    "firebase": "^12.4.0",
    "jszip": "^3.10.1",
    "lint": "^1.1.2",
    "lucide-react": "^0.546.0",
    "marked": "^13.0.3",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "typescript-eslint": "^8.46.1",
    "zod": "^3.25.76"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n TSC,VITE,ELECTRON \"tsc -w -p tsconfig.electron.json\" \"vite --config vite.config.mjs\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite --config vite.config.mjs",
    "build:renderer": "vite build --config vite.config.mjs",
    "build": "tsc -p tsconfig.electron.json && npm run build:renderer && electron-builder --dir",
    "dist": "tsc -p tsconfig.electron.json && npm run build:renderer && electron-builder -w -m",
    "lint": "eslint \"app/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"app/**/*.{ts,tsx,js,jsx}\" --fix",
    "fix": "npm run lint:fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "build": {
    "productName": "Portfoli-YOU",
    "appId": "dev.snxethan.portfoliyou",
    "files": [
      "app/**",
      "dist/**",
      "out/**"
    ],
    "win": {
      "icon": "app/renderer/public/icon.png",
      "artifactName": "Portfoli-YOU-${version}.exe"
    },
    "mac": {
      "icon": "app/renderer/public/icon.png",
      "artifactName": "Portfoli-YOU-${version}.dmg"
    },
    "linux": {
      "icon": "app/renderer/public/icon.png"
    }
  }
}